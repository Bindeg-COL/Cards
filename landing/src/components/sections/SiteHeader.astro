---
/**
 * SiteHeader (L4h) — barra superior con logo Bindeg, enlaces a anclas que existen
 * en la página y pill "Tarjetas de fidelidad en Wallet".
 *
 * Estructura:
 *  - El logo es un PNG con alfa real (public/brand/bindeg-logo-alpha.png), sin
 *    mix-blend-mode. Un blend en un elemento sticky obliga a recomponer la página
 *    bajo la barra en cada frame de scroll (junto con el blur del velo, el filtro
 *    gooey de MeltWord y la aurora animada) y producía tirones al desplazarse.
 *  - El velo (oscuro + blur) es un elemento hermano detrás del header; solo se
 *    activa al hacer scroll.
 *  - El skip link va antes del header y es el primero en el orden de foco.
 *
 * Sin JS el velo queda transparente (la barra sigue funcionando).
 *
 * L4q (decisión 011): toggle de tema de 3 estados (claro -> oscuro -> sistema), a la
 * derecha antes de la pill. El icono lo elige el CSS según data-theme-pref (lo pone
 * el script del <head>, así que no parpadea); el script de abajo guarda la elección
 * y actualiza el aria-label. Sin JS el botón no se muestra (no haría nada).
 * El logo son dos <img> (crema / tinta) alternados por tokens según el tema.
 *
 * @param {Array<{href: string, label: string}>} links - Enlaces de la nav (anclas existentes).
 */
interface Props {
  links: { href: string; label: string }[];
}

const { links } = Astro.props;
---

<a class="sh-skip" href="#contenido">Saltar al contenido</a>
<div class="sh-sentinel" aria-hidden="true" data-sh-sentinel></div>
<div class="sh-veil" aria-hidden="true" data-sh-veil></div>
<header class="sh" data-sh-header>
  <div class="sh__inner">
    <div class="sh__left">
      <a class="sh__logo" href="/" aria-label="Bindeg, inicio">
        <img class="sh__logo-img sh__logo-img--cream" src="/brand/bindeg-logo-alpha.png" alt="Bindeg" width="1140" height="290" decoding="async" />
        <img class="sh__logo-img sh__logo-img--ink" src="/brand/bindeg-logo-alpha-ink.png" alt="Bindeg" width="1140" height="290" decoding="async" />
      </a>
      <nav class="sh__nav" aria-label="Principal">
        {links.map((l) => <a class="sh__link" href={l.href}>{l.label}</a>)}
      </nav>
    </div>
    <div class="sh__right">
      <button class="sh__theme" type="button" aria-label="Cambiar el tema de color" data-sh-theme>
        <svg class="sh__ti sh__ti--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.25" />
          <path d="M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.46 5.46l1.41 1.41M17.13 17.13l1.41 1.41M5.46 18.54l1.41-1.41M17.13 6.87l1.41-1.41" />
        </svg>
        <svg class="sh__ti sh__ti--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M19.5 14.6A7.75 7.75 0 0 1 9.4 4.5a7.75 7.75 0 1 0 10.1 10.1Z" />
        </svg>
        <svg class="sh__ti sh__ti--system" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <rect x="3.25" y="4.25" width="17.5" height="12" rx="2.25" />
          <path d="M9 20.25h6M12 16.25v4" />
        </svg>
      </button>
      <span class="sh__pill">
        <span class="sh__dot" aria-hidden="true"></span>
        <span class="sh__pill-long">Tarjetas de fidelidad en Wallet</span>
        <span class="sh__pill-short">Tarjetas en Wallet</span>
      </span>
    </div>
  </div>
</header>

<script>
  const sentinel = document.querySelector('[data-sh-sentinel]');
  const header = document.querySelector<HTMLElement>('[data-sh-header]');
  const veil = document.querySelector<HTMLElement>('[data-sh-veil]');
  if (sentinel && header && veil && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const scrolled = !entry.isIntersecting;
      for (const el of [header, veil]) {
        if (scrolled) el.dataset.scrolled = '';
        else delete el.dataset.scrolled;
      }
    }).observe(sentinel);
  }

  // ---- L4q: toggle de tema (claro -> oscuro -> sistema) ----
  type Pref = 'light' | 'dark' | 'system';
  const KEY = 'bindeg-theme';
  const NEXT: Record<Pref, Pref> = { light: 'dark', dark: 'system', system: 'light' };
  const NAME: Record<Pref, string> = { light: 'claro', dark: 'oscuro', system: 'del sistema' };
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-sh-theme]');
  const themeApi = (window as unknown as { __bindegTheme?: { apply: (p: Pref) => void } }).__bindegTheme;
  const readPref = (): Pref => {
    const p = root.dataset.themePref;
    return p === 'light' || p === 'dark' || p === 'system' ? p : 'system';
  };
  const label = () => {
    if (!toggle) return;
    const pref = readPref();
    const now = pref === 'system' ? ` (ahora ${root.dataset.theme === 'light' ? 'claro' : 'oscuro'})` : '';
    toggle.setAttribute('aria-label', `Tema ${NAME[pref]}${now}. Cambiar a tema ${NAME[NEXT[pref]]}`);
  };
  if (toggle && themeApi) {
    let animTimer = 0;
    label();
    toggle.addEventListener('click', () => {
      const next = NEXT[readPref()];
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* sin localStorage: el cambio dura hasta recargar */
      }
      // Transición de color solo durante el cambio (global.css; nula con reduced motion).
      root.classList.add('theme-anim');
      themeApi.apply(next);
      window.clearTimeout(animTimer);
      animTimer = window.setTimeout(() => root.classList.remove('theme-anim'), 250);
      label();
    });
    // Con 'system', el script del <head> cambia el tema en vivo: refresca la etiqueta.
    new MutationObserver(label).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .sh,
  .sh-veil {
    --sh-h: 56px;
    position: sticky;
    top: 0;
    height: var(--sh-h);
    /* Se superpone al hero: la aurora queda detrás de la barra, sin corte. */
    margin-bottom: calc(-1 * var(--sh-h));
  }
  @media (min-width: 640px) {
    .sh,
    .sh-veil { --sh-h: 64px; }
  }

  .sh-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .sh-veil {
    z-index: 49;
    pointer-events: none;
    /* L4m: 0.86 para que la nav siga en AA al pasar sobre la hoja crema de "Pruébalo". */
    background: rgb(var(--c-bg-rgb) / 0.86);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--veil-rule);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .sh-veil[data-scrolled] { opacity: 1; }

  .sh {
    z-index: 50;
  }
  .sh__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--sp-6, 1.5rem);
  }
  .sh__left { display: flex; align-items: center; gap: 1.5rem; min-width: 0; }

  .sh__logo { display: inline-flex; align-items: center; border-radius: 4px; }
  .sh__logo img { display: block; height: 26px; width: auto; }
  @media (min-width: 640px) { .sh__logo img { height: 30px; } }
  @media (min-width: 1024px) { .sh__logo img { height: 34px; } }
  /* L4q: logo crema en oscuro, tinta en claro (sin filter). */
  .sh__logo .sh__logo-img--ink { display: none; }
  :global(:root[data-theme='light']) .sh__logo .sh__logo-img--cream { display: none; }
  :global(:root[data-theme='light']) .sh__logo .sh__logo-img--ink { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .sh__logo .sh__logo-img--cream { display: none; }
    :global(:root:not([data-theme])) .sh__logo .sh__logo-img--ink { display: block; }
  }

  .sh__nav { display: none; align-items: center; gap: 0.25rem; }
  @media (min-width: 640px) { .sh__nav { display: flex; } }
  .sh__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--r-full, 999px);
    font-size: 0.875rem;
    color: var(--c-text-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .sh__link:hover { color: var(--c-text-1); }

  .sh__logo:focus-visible,
  .sh__link:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
    border-radius: var(--r-full, 999px);
  }

  .sh__right { flex: none; display: flex; align-items: center; gap: 0.5rem; }

  /* L4q: toggle de tema (icono de 40px; 44px en táctil). */
  .sh__theme {
    position: relative;
    flex: none;
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--c-border);
    border-radius: 50%;
    background: rgb(var(--ink-rgb) / 0.05);
    color: var(--c-text-2);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  :global(:root[data-theme-pref]) .sh__theme { display: grid; }
  @media (pointer: coarse) {
    .sh__theme { width: 44px; height: 44px; }
  }
  .sh__theme:hover { color: var(--c-text-1); border-color: var(--c-border-strong); }
  .sh__theme:focus-visible { outline: 2px solid var(--c-focus); outline-offset: 3px; }
  .sh__ti {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition: opacity 250ms ease, transform 250ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(:root[data-theme-pref='light']) .sh__ti--sun,
  :global(:root[data-theme-pref='dark']) .sh__ti--moon,
  :global(:root[data-theme-pref='system']) .sh__ti--system {
    opacity: 1;
    transform: none;
  }

  .sh__pill {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-full, 999px);
    background: rgb(var(--ink-rgb) / 0.05);
    border: 1px solid var(--c-border);
    font-size: 0.8125rem;
    color: var(--c-text-1);
    white-space: nowrap;
  }
  .sh__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  /* display:none también lo oculta al lector de pantalla: solo se oye un texto. */
  .sh__pill-long { display: none; }
  @media (min-width: 640px) {
    .sh__pill-long { display: inline; }
    .sh__pill-short { display: none; }
  }
  /* L4k: con 5 enlaces (Precios) la barra no cabe entre 640 y 839 px:
     sin pill hasta 767 y con el texto corto hasta 839.
     L4q: con el toggle, en ese tramo ceden los enlaces (menos relleno y hueco). */
  @media (min-width: 640px) and (max-width: 839.98px) {
    .sh__left { gap: 1rem; }
    .sh__nav { gap: 0; }
    .sh__link { padding: 0 0.5rem; }
  }
  @media (min-width: 640px) and (max-width: 767.98px) {
    .sh__pill { display: none; }
  }
  @media (min-width: 768px) and (max-width: 839.98px) {
    .sh__pill-long { display: none; }
    .sh__pill-short { display: inline; }
  }

  .sh-skip {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .sh-skip:focus {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 60;
    width: auto;
    height: auto;
    overflow: visible;
    clip: auto;
    padding: 0.6rem 1rem;
    border-radius: var(--r-full, 999px);
    background: var(--c-text-1);
    color: var(--c-bg);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sh-veil, .sh__link, .sh__theme, .sh__ti { transition: none; }
  }
</style>
